# Stage status to start server:
#   - "dev", for start server without graceful shutdown
#   - "prod", for start server with graceful shutdown
STAGE_STATUS="dev"

# Server settings:
SERVER_HOST="0.0.0.0"
SERVER_PORT=5000
SERVER_READ_TIMEOUT=60

# JWT settings (test only, min 16 chars to satisfy ValidateEnv):
JWT_SECRET_KEY="test-secret-key-1234567890"
JWT_SECRET_KEY_EXPIRE_MINUTES_COUNT=15
JWT_REFRESH_KEY="test-refresh-key-1234567890"
JWT_REFRESH_KEY_EXPIRE_HOURS_COUNT=720

# Database settings (tests run against in-memory SQLite, no services needed):
SQL_DSN=
SQLITE_PATH="file::memory:?cache=shared"
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFETIME_CONNECTIONS=2

# Redis settings:
REDIS_HOST="host.docker.internal"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB_NUMBER=0
